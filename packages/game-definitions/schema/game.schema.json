{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenFight Game Definition",
  "description": "Declarative per-game TOML converted to JSON schema for validation",
  "type": "object",
  "required": ["schema_version", "id", "name", "emulator"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version — must be 1 for MVP"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,20}$",
      "description": "Canonical game id, used as games.slug / directory name"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable display name"
    },
    "emulator": {
      "type": "string",
      "enum": ["fbneo", "flycast", "snes9x"],
      "description": "Emulator adapter id"
    },
    "launch": {
      "type": "object",
      "required": ["args"],
      "additionalProperties": false,
      "properties": {
        "args": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Launch template — must contain {rom} placeholder once"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "bios": {
          "type": "string"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "year": { "type": "integer", "minimum": 1970, "maximum": 2030 },
        "developer": { "type": "string" },
        "players": { "type": "integer", "minimum": 1, "maximum": 4 }
      }
    }
  }
}
