{
  "name": "openfight",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "description": "OpenFight monorepo root",
  "scripts": {
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm --filter @openfight/protocol build && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
