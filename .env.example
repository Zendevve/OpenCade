# OpenCade environment — copy to .env and adjust for your machine.
# Docker Compose reads this automatically when present.

DATABASE_URL=postgres://opencade:opencade@db:5432/opencade
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-bytes
ALLOWED_ORIGINS=http://localhost:1420,tauri://localhost
OPENCADE_ENV=production

# Optional overrides:
# RUST_LOG=info
# PORT=8080
# POSTGRES_USER=opencade
# POSTGRES_PASSWORD=opencade
# POSTGRES_DB=opencade
