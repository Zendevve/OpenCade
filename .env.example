# OpenCade environment — copy to .env and adjust for your machine.
# Docker Compose reads this automatically when present.
# For local dev, `docker compose up -d` works without a .env thanks to
# defaults in docker-compose.yml. Copy this file only to override.
# Generate real secrets with: openssl rand -hex 32 (64 hex chars, >32 bytes)

POSTGRES_PASSWORD=opencade-dev-postgres-password-change-me
DATABASE_URL=postgres://opencade:opencade-dev-postgres-password-change-me@db:5432/opencade
# dev defaults satisfy production length checks; replace before any non-local deploy
SESSION_SECRET=dev-session-secret-change-me-at-least-32-bytes-long
RELAY_AUTH_SECRET=dev-relay-secret-change-me-at-least-32-bytes-long
OPERATOR_TOKEN=dev-operator-token-change-me-at-least-32-bytes-long
ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost
OPENCADE_ENV=production
PUBLIC_RELAY_URL=wss://relay.example.com/relay
STUN_HOST=stun.example.com

# Optional overrides:
# RUST_LOG=info
# PORT=8080
# POSTGRES_USER=opencade
# POSTGRES_DB=opencade
# RFC 8489 server as a numeric IP:port. Both variables should identify the same service.
# OPENCADE_STUN_SERVER=203.0.113.10:3478
# Evidence-gated native route promotion. Leave disabled until physical-host evidence qualifies.
# OPENCADE_EVIDENCE_TCP_TUNNEL=false
# ROUTE_POLICY_MIN_ATTEMPTS=10
