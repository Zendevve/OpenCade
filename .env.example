# OpenCade environment — copy to .env and adjust for your machine.
# Docker Compose reads this automatically when present.

POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgres://opencade:replace-with-a-random-database-password@db:5432/opencade
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Generate independently with: openssl rand -hex 32
RELAY_AUTH_SECRET=replace-with-a-different-32-byte-random-secret
# Generate independently; protects metrics and aggregate decision endpoints.
OPERATOR_TOKEN=replace-with-a-third-32-byte-random-secret
ALLOWED_ORIGINS=http://localhost:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost
OPENCADE_ENV=production
PUBLIC_RELAY_URL=wss://relay.example.com/relay
STUN_HOST=stun.example.com

# Optional overrides:
# RUST_LOG=info
# PORT=8080
# POSTGRES_USER=opencade
# POSTGRES_DB=opencade
# RFC 8489 server as a numeric IP:port. Both variables should identify the same service.
# OPENCADE_STUN_SERVER=203.0.113.10:3478
# Evidence-gated native route promotion. Leave disabled until physical-host evidence qualifies.
# OPENCADE_EVIDENCE_TCP_TUNNEL=false
# ROUTE_POLICY_MIN_ATTEMPTS=10
