# OpenFight environment — copy to .env and adjust for your machine.
# Docker Compose reads this automatically when present.

DATABASE_URL=postgres://openfight:openfight@db:5432/openfight
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-bytes
ALLOWED_ORIGINS=http://localhost:1420,tauri://localhost
OPENFIGHT_ENV=production

# Optional overrides:
# RUST_LOG=info
# PORT=8080
# POSTGRES_USER=openfight
# POSTGRES_PASSWORD=openfight
# POSTGRES_DB=openfight
