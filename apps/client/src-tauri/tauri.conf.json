{
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "category": "Game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "productName": "OpenCade",
  "mainBinaryName": "OpenCade",
  "version": "0.1.0",
  "identifier": "com.opencade.client",
  "plugins": {},
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "height": 720,
        "resizable": true,
        "title": "OpenCade",
        "width": 1280,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:* https: wss:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  }
}
